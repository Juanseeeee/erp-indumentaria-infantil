{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "seed": "ts-node --transpile-only prisma/seed/index.ts",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@erp/contracts": "workspace:*",
    "@erp/domain-core": "workspace:*",
    "@erp/domain-finance": "workspace:*",
    "@erp/domain-production": "workspace:*",
    "@erp/domain-sales": "workspace:*",
    "@erp/domain-stock": "workspace:*",
    "@google/genai": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "nodemailer": "6.9.16",
    "pdfkit": "0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "^6.0.2",
    "esbuild": "0.21.5",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed/index.ts"
  }
}
