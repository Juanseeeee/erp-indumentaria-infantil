enum DispatchStatus {
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

/// Envío a taller: materiales (transferidos a su depósito) + prendas a confeccionar.
model WorkshopDispatch {
  id         String                 @id @default(uuid()) @db.Uuid
  companyId  String                 @map("company_id") @db.Uuid
  number     String
  orderId    String                 @map("order_id") @db.Uuid
  workshopId String                 @map("workshop_id") @db.Uuid
  status     DispatchStatus         @default(SENT)
  sentAt     DateTime               @default(now()) @map("sent_at") @db.Timestamptz
  expectedAt DateTime?              @map("expected_at") @db.Date
  notes      String?
  createdBy  String                 @map("created_by") @db.Uuid
  lines      WorkshopDispatchLine[]

  @@unique([companyId, number])
  @@index([companyId, workshopId, status])
  @@map("workshop_dispatches")
}

model WorkshopDispatchLine {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  dispatchId  String           @map("dispatch_id") @db.Uuid
  /// MATERIAL: stock transferido al depósito del taller. GARMENT: prendas a confeccionar.
  kind        String
  itemId      String           @map("item_id") @db.Uuid
  qty         Decimal          @db.Decimal(18, 4)
  receivedQty Decimal          @default(0) @map("received_qty") @db.Decimal(18, 4)
  dispatch    WorkshopDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("workshop_dispatch_lines")
}

/// Ingreso de producción con control de calidad (interno o recepción de taller).
/// Solo lo aprobado entra a producto terminado; la segunda selección va a su depósito.
model ProductionOutput {
  id           String                 @id @default(uuid()) @db.Uuid
  companyId    String                 @map("company_id") @db.Uuid
  number       String
  orderId      String                 @map("order_id") @db.Uuid
  workshopId   String?                @map("workshop_id") @db.Uuid
  dispatchId   String?                @map("dispatch_id") @db.Uuid
  settlementId String?                @map("settlement_id") @db.Uuid
  notes        String?
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String                 @map("created_by") @db.Uuid
  lines        ProductionOutputLine[]

  @@unique([companyId, number])
  @@index([companyId, workshopId, settlementId])
  @@map("production_outputs")
}

model ProductionOutputLine {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  outputId       String           @map("output_id") @db.Uuid
  variantItemId  String           @map("variant_item_id") @db.Uuid
  approvedQty    Decimal          @map("approved_qty") @db.Decimal(18, 4)
  secondQty      Decimal          @default(0) @map("second_qty") @db.Decimal(18, 4)
  scrapQty       Decimal          @default(0) @map("scrap_qty") @db.Decimal(18, 4)
  defectReasonId String?          @map("defect_reason_id") @db.Uuid
  unitCost       Decimal          @map("unit_cost") @db.Decimal(18, 6)
  /// Tarifa del taller por prenda vigente al recibir (null en producción interna).
  workshopRate   Decimal?         @map("workshop_rate") @db.Decimal(18, 2)
  output         ProductionOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@map("production_output_lines")
}

model WorkshopSettlement {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  number           String
  workshopId       String          @map("workshop_id") @db.Uuid
  status           FiscalDocStatus @default(POSTED)
  grossTotal       Decimal         @map("gross_total") @db.Decimal(18, 2)
  deductions       Decimal         @default(0) @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)
  /// [{ description, amount }]
  deductionDetail  Json            @default("[]") @map("deduction_detail")
  fiscalDocumentId String?         @map("fiscal_document_id") @db.Uuid
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String          @map("created_by") @db.Uuid

  @@unique([companyId, number])
  @@map("workshop_settlements")
}

model ProductionCostSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  kind       String
  materials  Decimal  @db.Decimal(18, 2)
  workshop   Decimal  @db.Decimal(18, 2)
  overhead   Decimal  @db.Decimal(18, 2)
  total      Decimal  @db.Decimal(18, 2)
  goodUnits  Decimal  @map("good_units") @db.Decimal(18, 4)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(18, 6)
  detail     Json     @default("{}")
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz
  computedBy String   @map("computed_by") @db.Uuid

  @@index([companyId, orderId])
  @@map("production_cost_snapshots")
}

// ───────────────────────────── Ventas ─────────────────────────────

enum PriceListKind {
  WHOLESALE
  RETAIL
  SPECIAL
}

model PriceList {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  name        String
  kind        PriceListKind @default(WHOLESALE)
  includesVat Boolean       @default(false) @map("includes_vat")
  /// Lista derivada: precio = base × (1 + markup %). No guarda precios propios.
  baseListId  String?       @map("base_list_id") @db.Uuid
  markupPct   Decimal?      @map("markup_pct") @db.Decimal(7, 2)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([companyId, name])
  @@map("price_lists")
}

/// Historial de precios: cada cambio es una fila nueva. Vigente = la más reciente con valid_from <= hoy.
/// Precio por modelo (product_id) con excepción por variante (item_id).
model PriceListPrice {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  itemId      String?  @map("item_id") @db.Uuid
  price       Decimal  @db.Decimal(18, 2)
  validFrom   DateTime @map("valid_from") @db.Date
  /// Actualización masiva que lo generó.
  batchId     String?  @map("batch_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String   @map("created_by") @db.Uuid

  @@index([priceListId, productId, validFrom])
  @@index([priceListId, itemId, validFrom])
  @@map("price_list_prices")
}

/// Vendedor: usuario con % de comisión (la comisión se devenga sobre lo cobrado).
model SalesRep {
  userId        String   @map("user_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  commissionPct Decimal  @default(0) @map("commission_pct") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, userId])
  @@map("sales_reps")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  CANCELLED
}

model SalesOrder {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  number           String
  customerId       String           @map("customer_id") @db.Uuid
  sellerUserId     String?          @map("seller_user_id") @db.Uuid
  status           SalesOrderStatus @default(DRAFT)
  orderDate        DateTime         @map("order_date") @db.Date
  promisedAt       DateTime?        @map("promised_at") @db.Date
  priceListId      String?          @map("price_list_id") @db.Uuid
  warehouseId      String           @map("warehouse_id") @db.Uuid
  paymentTermId    String?          @map("payment_term_id") @db.Uuid
  deliveryAddress  String?          @map("delivery_address")
  notes            String?
  /// Neto (sin IVA) y total con IVA de lo pedido.
  netTotal         Decimal          @default(0) @map("net_total") @db.Decimal(18, 2)
  total            Decimal          @default(0) @db.Decimal(18, 2)
  /// Autorización de crédito excedido (quién y por qué).
  creditApprovedBy String?          @map("credit_approved_by") @db.Uuid
  creditNote       String?          @map("credit_note")
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String           @map("created_by") @db.Uuid
  lines            SalesOrderLine[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  orderId       String     @map("order_id") @db.Uuid
  itemId        String     @map("item_id") @db.Uuid
  qty           Decimal    @db.Decimal(18, 4)
  /// Neto de IVA, antes del descuento.
  unitPrice     Decimal    @map("unit_price") @db.Decimal(18, 6)
  discountPct   Decimal    @default(0) @map("discount_pct") @db.Decimal(5, 2)
  vatRate       Decimal    @default(21) @map("vat_rate") @db.Decimal(5, 2)
  deliveredQty  Decimal    @default(0) @map("delivered_qty") @db.Decimal(18, 4)
  cancelledQty  Decimal    @default(0) @map("cancelled_qty") @db.Decimal(18, 4)
  /// Reserva activa de la línea (una por línea; "reservar pendientes" la reemplaza).
  reservationId String?    @map("reservation_id") @db.Uuid
  /// Promoción que fijó el descuento de la línea (null: descuento del cliente o manual).
  promotionId   String?    @map("promotion_id") @db.Uuid
  order         SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@unique([orderId, itemId])
  @@index([promotionId])
  @@map("sales_order_lines")
}

enum DeliveryNoteStatus {
  ISSUED
  VOIDED
}

/// Remito: única salida de stock por venta.
model DeliveryNote {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  number      String
  customerId  String             @map("customer_id") @db.Uuid
  orderId     String?            @map("order_id") @db.Uuid
  warehouseId String             @map("warehouse_id") @db.Uuid
  status      DeliveryNoteStatus @default(ISSUED)
  issueDate   DateTime           @map("issue_date") @db.Date
  carrier     String?
  packages    Int?
  notes       String?
  /// Factura que lo incluye (un remito se factura completo, una sola vez).
  invoiceId   String?            @map("invoice_id") @db.Uuid
  voidReason  String?            @map("void_reason")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String             @map("created_by") @db.Uuid
  lines       DeliveryNoteLine[]

  @@unique([companyId, number])
  @@index([companyId, customerId, invoiceId])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  deliveryId  String       @map("delivery_id") @db.Uuid
  orderLineId String?      @map("order_line_id") @db.Uuid
  itemId      String       @map("item_id") @db.Uuid
  qty         Decimal      @db.Decimal(18, 4)
  unitPrice   Decimal      @map("unit_price") @db.Decimal(18, 6)
  discountPct Decimal      @default(0) @map("discount_pct") @db.Decimal(5, 2)
  vatRate     Decimal      @default(21) @map("vat_rate") @db.Decimal(5, 2)
  /// Costo de salida (para devoluciones al mismo costo y para margen).
  unitCost    Decimal      @default(0) @map("unit_cost") @db.Decimal(18, 6)
  delivery    DeliveryNote @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_note_lines")
}

enum ReceiptStatus {
  POSTED
  VOIDED
}

enum CashAccountType {
  CASH_BOX
  BANK
  WALLET
  CARD_CLEARING
  CHEQUE_PORTFOLIO
}

enum TreasuryDirection {
  IN
  OUT
}

/// Recibo de cobro. En la Fase 4 los medios se vinculan con cajas, bancos y cheques en cartera.
model CustomerReceipt {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  number     String
  customerId String           @map("customer_id") @db.Uuid
  date       DateTime         @db.Date
  total      Decimal          @db.Decimal(18, 2)
  status     ReceiptStatus    @default(POSTED)
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String           @map("created_by") @db.Uuid
  payments   ReceiptPayment[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@map("customer_receipts")
}

model ReceiptPayment {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  receiptId     String          @map("receipt_id") @db.Uuid
  /// CASH, TRANSFER, CHEQUE, ECHEQ, CARD, MERCADO_PAGO, RETENTION
  method        String
  amount        Decimal         @db.Decimal(18, 2)
  reference     String?
  bank          String?
  dueDate       DateTime?       @map("due_date") @db.Date
  /// Cuenta de tesorería donde entró el dinero (nula para retenciones).
  cashAccountId String?         @map("cash_account_id") @db.Uuid
  chequeId      String?         @map("cheque_id") @db.Uuid
  receipt       CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  cashAccount   CashAccount?    @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  cheque        Cheque?         @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  @@map("receipt_payments")
}

model CashAccount {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  type                 CashAccountType
  name                 String
  bank                 String?
  accountReference     String?               @map("account_reference")
  currency             String                @default("ARS") @db.VarChar(3)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  movements            TreasuryMovement[]
  cheques              Cheque[]
  receiptPayments      ReceiptPayment[]
  supplierPaymentLines SupplierPaymentLine[]
  transfersOut         TreasuryTransfer[]    @relation("TransferFrom")
  transfersIn          TreasuryTransfer[]    @relation("TransferTo")
  closings             CashClosing[]
  expenses             Expense[]
  statements           BankStatement[]
  expenseTemplates     ExpenseTemplate[]
  statementLines       BankStatementLine[]

  @@unique([companyId, name])
  @@index([companyId, type])
  @@map("cash_accounts")
}

/// Append-only. Cada corrección debe registrarse como otro movimiento.
model TreasuryMovement {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  cashAccountId   String             @map("cash_account_id") @db.Uuid
  direction       TreasuryDirection
  amount          Decimal            @db.Decimal(18, 2)
  currency        String             @db.VarChar(3)
  operationDate   DateTime           @map("operation_date") @db.Date
  valueDate       DateTime           @map("value_date") @db.Date
  concept         String
  paymentMethod   String?            @map("payment_method")
  sourceDocType   String?            @map("source_doc_type")
  sourceDocId     String?            @map("source_doc_id") @db.Uuid
  transferGroupId String?            @map("transfer_group_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String             @map("created_by") @db.Uuid
  cashAccount     CashAccount        @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  closings        CashClosing[]
  statementLine   BankStatementLine?

  @@index([companyId, cashAccountId, operationDate], map: "treasury_movements_company_id_cash_account_id_operation_date_id")
  @@index([companyId, cashAccountId, valueDate])
  @@map("treasury_movements")
}

enum ChequeOwnership {
  THIRD
  OWN
}

enum ChequeStatus {
  IN_PORTFOLIO
  DELIVERED
  DEPOSITED
  CREDITED
  REJECTED
  RETURNED
  ISSUED
  DEBITED
  VOIDED
}

/// Cheque físico o e-cheq. El estado solo cambia por eventos (cheque_events, append-only).
/// Un mismo cheque vigente (banco + número) no puede cargarse dos veces.
model Cheque {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  ownership            ChequeOwnership
  isEcheq              Boolean               @default(false) @map("is_echeq")
  bank                 String
  number               String
  amount               Decimal               @db.Decimal(18, 2)
  currency             String                @default("ARS") @db.VarChar(3)
  issueDate            DateTime?             @map("issue_date") @db.Date
  paymentDate          DateTime              @map("payment_date") @db.Date
  drawerName           String?               @map("drawer_name")
  drawerTaxId          String?               @map("drawer_tax_id")
  status               ChequeStatus
  /// Cliente que lo entregó (terceros) o proveedor al que se entregó.
  receivedFromId       String?               @map("received_from_id") @db.Uuid
  deliveredToId        String?               @map("delivered_to_id") @db.Uuid
  /// Dónde está: cartera o banco donde se depositó.
  cashAccountId        String?               @map("cash_account_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String                @map("created_by") @db.Uuid
  cashAccount          CashAccount?          @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  events               ChequeEvent[]
  receiptPayments      ReceiptPayment[]
  supplierPaymentLines SupplierPaymentLine[]

  @@index([companyId, status, paymentDate])
  @@map("cheques")
}

model ChequeEvent {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  chequeId      String        @map("cheque_id") @db.Uuid
  event         String
  fromStatus    ChequeStatus? @map("from_status")
  toStatus      ChequeStatus  @map("to_status")
  date          DateTime      @db.Date
  cashAccountId String?       @map("cash_account_id") @db.Uuid
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String        @map("created_by") @db.Uuid
  cheque        Cheque        @relation(fields: [chequeId], references: [id])

  @@index([companyId, chequeId])
  @@map("cheque_events")
}

/// Orden de pago a proveedor o taller. Genera el débito en su cuenta corriente y se imputa a sus facturas.
model SupplierPayment {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  number             String
  supplierId         String                @map("supplier_id") @db.Uuid
  date               DateTime              @db.Date
  total              Decimal               @db.Decimal(18, 2)
  /// PENDING_APPROVAL, POSTED, REJECTED, VOIDED
  status             String                @default("POSTED")
  approvedBy         String?               @map("approved_by") @db.Uuid
  approvedAt         DateTime?             @map("approved_at") @db.Timestamptz
  rejectionReason    String?               @map("rejection_reason")
  /// Imputaciones pedidas al cargarla; se aplican al aprobarla.
  pendingAllocations Json?                 @map("pending_allocations")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String                @map("created_by") @db.Uuid
  lines              SupplierPaymentLine[]

  @@unique([companyId, number])
  @@index([companyId, supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentLine {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  paymentId     String          @map("payment_id") @db.Uuid
  /// CASH, TRANSFER, THIRD_CHEQUE, OWN_CHEQUE, OWN_ECHEQ, RETENTION
  method        String
  amount        Decimal         @db.Decimal(18, 2)
  reference     String?
  cashAccountId String?         @map("cash_account_id") @db.Uuid
  chequeId      String?         @map("cheque_id") @db.Uuid
  /// Fecha de pago del cheque propio (se emite al aprobar la orden).
  paymentDate   DateTime?       @map("payment_date") @db.Date
  payment       SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  cashAccount   CashAccount?    @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  cheque        Cheque?         @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  @@map("supplier_payment_lines")
}

/// Transferencia entre dos cuentas propias. Genera la salida, la entrada y, si hay, la comisión
/// (movimientos con el mismo transfer_group_id = id). Se anula con contramovimientos.
model TreasuryTransfer {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  number        String
  date          DateTime      @db.Date
  valueDate     DateTime      @map("value_date") @db.Date
  fromAccountId String        @map("from_account_id") @db.Uuid
  toAccountId   String        @map("to_account_id") @db.Uuid
  amount        Decimal       @db.Decimal(18, 2)
  fee           Decimal       @default(0) @db.Decimal(18, 2)
  concept       String?
  status        ReceiptStatus @default(POSTED)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String        @map("created_by") @db.Uuid
  fromAccount   CashAccount   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     CashAccount   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("treasury_transfers")
}

/// Arqueo de caja. Append-only. La diferencia se registra como un movimiento de ajuste y la caja
/// deja de admitir movimientos con fecha anterior.
model CashClosing {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @map("company_id") @db.Uuid
  cashAccountId        String            @map("cash_account_id") @db.Uuid
  closingDate          DateTime          @map("closing_date") @db.Date
  expected             Decimal           @db.Decimal(18, 2)
  counted              Decimal           @db.Decimal(18, 2)
  difference           Decimal           @db.Decimal(18, 2)
  notes                String?
  adjustmentMovementId String?           @map("adjustment_movement_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String            @map("created_by") @db.Uuid
  cashAccount          CashAccount       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  adjustmentMovement   TreasuryMovement? @relation(fields: [adjustmentMovementId], references: [id], onDelete: Restrict)

  @@index([companyId, cashAccountId, closingDate])
  @@map("cash_closings")
}

model CostCenter {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expenses  Expense[]
  templates ExpenseTemplate[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

/// Gasto pagado desde una caja, banco o billetera, con categoría y centro de costo.
model Expense {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  number            String
  date              DateTime         @db.Date
  categoryId        String           @map("category_id") @db.Uuid
  costCenterId      String           @map("cost_center_id") @db.Uuid
  supplierId        String?          @map("supplier_id") @db.Uuid
  description       String
  /// Comprobante del gasto (ticket, factura) tal como figura en papel.
  documentReference String?          @map("document_reference")
  amount            Decimal          @db.Decimal(18, 2)
  cashAccountId     String           @map("cash_account_id") @db.Uuid
  status            ReceiptStatus    @default(POSTED)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String           @map("created_by") @db.Uuid
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenter        CostCenter       @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  cashAccount       CashAccount      @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  /// Gasto recurrente: plantilla y mes (AAAA-MM) que cubre.
  templateId        String?          @map("template_id") @db.Uuid
  period            String?
  template          ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, costCenterId, date])
  @@map("expenses")
}

/// Imputación entre un movimiento deudor (factura, débito) y uno acreedor (cobro, crédito).
/// Append-only: la reversa es otra fila con reversal_of_id; el original no se toca.
model AccountAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  debitEntryId  String   @map("debit_entry_id") @db.Uuid
  creditEntryId String   @map("credit_entry_id") @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  reversalOfId  String?  @unique @map("reversal_of_id") @db.Uuid
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String   @map("created_by") @db.Uuid

  @@index([companyId, debitEntryId])
  @@index([companyId, creditEntryId])
  @@map("account_allocations")
}

/// Comisión devengada por un cobro imputado a una factura (negativa si se revierte la imputación).
model SalesCommission {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  sellerUserId String   @map("seller_user_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  allocationId String   @unique @map("allocation_id") @db.Uuid
  collectedAt  DateTime @map("collected_at") @db.Date
  baseAmount   Decimal  @map("base_amount") @db.Decimal(18, 2)
  pct          Decimal  @db.Decimal(5, 2)
  amount       Decimal  @db.Decimal(18, 2)
  settlementId String?  @map("settlement_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId, sellerUserId, settlementId])
  @@map("sales_commissions")
}

model CommissionSettlement {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  number       String
  sellerUserId String   @map("seller_user_id") @db.Uuid
  periodTo     DateTime @map("period_to") @db.Date
  total        Decimal  @db.Decimal(18, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid

  @@unique([companyId, number])
  @@map("commission_settlements")
}

/// Extracto bancario importado (CSV). Sus líneas se concilian contra los movimientos de tesorería.
model BankStatement {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  cashAccountId String              @map("cash_account_id") @db.Uuid
  fileName      String              @map("file_name")
  periodFrom    DateTime            @map("period_from") @db.Date
  periodTo      DateTime            @map("period_to") @db.Date
  lineCount     Int                 @map("line_count")
  /// Líneas que ya estaban importadas desde otro archivo.
  skippedCount  Int                 @default(0) @map("skipped_count")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String              @map("created_by") @db.Uuid
  cashAccount   CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  lines         BankStatementLine[]

  @@index([companyId, cashAccountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  statementId   String            @map("statement_id") @db.Uuid
  cashAccountId String            @map("cash_account_id") @db.Uuid
  lineNumber    Int               @map("line_number")
  date          DateTime          @db.Date
  description   String
  reference     String?
  /// Con signo, como lo muestra el banco: crédito +, débito −.
  amount        Decimal           @db.Decimal(18, 2)
  lineKey       String            @map("line_key")
  /// PENDING, MATCHED, CREATED, IGNORED
  status        String            @default("PENDING")
  movementId    String?           @unique @map("movement_id") @db.Uuid
  notes         String?
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz
  resolvedBy    String?           @map("resolved_by") @db.Uuid
  statement     BankStatement     @relation(fields: [statementId], references: [id], onDelete: Restrict)
  cashAccount   CashAccount       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  movement      TreasuryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([companyId, cashAccountId, lineKey])
  @@index([companyId, statementId])
  @@map("bank_statement_lines")
}

/// Historial de cierres y reaperturas de período. Append-only.
model PeriodLock {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  /// CLOSE, REOPEN
  action        String
  previousUntil DateTime? @map("previous_until") @db.Date
  lockedUntil   DateTime? @map("locked_until") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid

  @@index([companyId, createdAt])
  @@map("period_locks")
}

/// Gasto recurrente (alquiler, servicios, abonos): se registra una vez por mes desde la plantilla.
model ExpenseTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  name          String
  categoryId    String      @map("category_id") @db.Uuid
  costCenterId  String      @map("cost_center_id") @db.Uuid
  cashAccountId String      @map("cash_account_id") @db.Uuid
  supplierId    String?     @map("supplier_id") @db.Uuid
  /// Importe habitual: se puede corregir al registrar.
  amount        Decimal     @db.Decimal(18, 2)
  dayOfMonth    Int         @map("day_of_month")
  startsOn      DateTime    @map("starts_on") @db.Date
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String      @map("created_by") @db.Uuid
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  cashAccount   CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  expenses      Expense[]

  @@unique([companyId, name])
  @@map("expense_templates")
}

// ───────────────────────────── Alertas ─────────────────────────────

/// Configuración por empresa de una regla del catálogo (contracts/alerts.ts).
model AlertRule {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  enabled   Boolean  @default(true)
  /// LOW, NORMAL, HIGH, CRITICAL
  priority  String
  roles     String[] @default([])
  userIds   String[] @default([]) @map("user_ids") @db.Uuid
  sendEmail Boolean  @default(true) @map("send_email")
  days      Int?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String   @map("updated_by") @db.Uuid

  @@unique([companyId, code])
  @@map("alert_rules")
}

/// Unicidad (company, code, dedup_key) mientras cleared_at es NULL: índice parcial vía SQL.
model Alert {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  code           String
  dedupKey       String    @map("dedup_key")
  priority       String
  title          String
  detail         String?
  link           String?
  /// NEW, SEEN, RESOLVED
  status         String    @default("NEW")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastDetectedAt DateTime  @default(now()) @map("last_detected_at") @db.Timestamptz
  seenAt         DateTime? @map("seen_at") @db.Timestamptz
  seenBy         String?   @map("seen_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  /// NULL con resolved_at: se resolvió sola (la condición desapareció).
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolutionNote String?   @map("resolution_note")
  clearedAt      DateTime? @map("cleared_at") @db.Timestamptz

  @@index([companyId, status, createdAt])
  @@map("alerts")
}

/// Outbox de correos: se encola en la transacción de negocio y lo despacha EmailDispatcher.
model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  toEmail   String    @map("to_email")
  toName    String?   @map("to_name")
  subject   String
  textBody  String    @map("text_body")
  htmlBody  String?   @map("html_body")
  kind      String
  /// PENDING, SENT, FAILED
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sentAt    DateTime? @map("sent_at") @db.Timestamptz

  @@index([companyId, status, createdAt])
  @@map("email_outbox")
}

/// Promoción comercial: % de descuento con vigencia, mínimo de unidades y alcance.
model Promotion {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  name         String
  discountPct  Decimal          @map("discount_pct") @db.Decimal(5, 2)
  minQty       Decimal          @default(0) @map("min_qty") @db.Decimal(18, 4)
  /// ALL, PRODUCTS, CATEGORIES, COLLECTIONS
  scope        String
  targetIds    String[]         @default([]) @map("target_ids") @db.Uuid
  customerIds  String[]         @default([]) @map("customer_ids") @db.Uuid
  priceListIds String[]         @default([]) @map("price_list_ids") @db.Uuid
  validFrom    DateTime         @map("valid_from") @db.Date
  validTo      DateTime?        @map("valid_to") @db.Date
  isActive     Boolean          @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String           @map("created_by") @db.Uuid
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  orderLines   SalesOrderLine[]

  @@unique([companyId, name])
  @@index([companyId, validFrom])
  @@map("promotions")
}
