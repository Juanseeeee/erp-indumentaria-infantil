// ───────────────────────────── Comprobantes y cuentas corrientes ─────────────────────────────

enum DocDirection {
  SALE
  PURCHASE
}

enum FiscalDocStatus {
  POSTED
  VOIDED
  /// Venta electrónica esperando CAE (se reintenta; no impacta en la cuenta corriente).
  PENDING_AUTH
  /// ARCA lo rechazó: no tiene número ni efectos.
  REJECTED
}

/// Comprobantes. En Fase 2: facturas de proveedor y liquidaciones de taller.
model FiscalDocument {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  direction         DocDirection
  partyId           String               @map("party_id") @db.Uuid
  /// FA, FB, FC, NCA, ..., LIQ_TALLER
  docType           String               @map("doc_type")
  pointOfSale       Int                  @map("point_of_sale")
  /// Nulo mientras una venta electrónica espera su CAE (ARCA asigna el número).
  number            Int?
  issueDate         DateTime             @map("issue_date") @db.Date
  dueDate           DateTime?            @map("due_date") @db.Date
  netTotal          Decimal              @map("net_total") @db.Decimal(18, 2)
  vatTotal          Decimal              @map("vat_total") @db.Decimal(18, 2)
  otherTaxes        Decimal              @default(0) @map("other_taxes") @db.Decimal(18, 2)
  total             Decimal              @db.Decimal(18, 2)
  status            FiscalDocStatus      @default(POSTED)
  sourceType        String               @map("source_type")
  sourceId          String?              @map("source_id") @db.Uuid
  notes             String?
  warnings          Json                 @default("[]")
  /// Ventas: autorización electrónica.
  cae               String?
  caeDueDate        DateTime?            @map("cae_due_date") @db.Date
  /// SIMULATED (sin validez fiscal), HOMOLOGATION o PRODUCTION.
  arcaMode          String?              @map("arca_mode")
  arcaResult        Json?                @map("arca_result")
  /// Nota de crédito o débito: comprobante que ajusta.
  relatedDocumentId String?              @map("related_document_id") @db.Uuid
  sellerUserId      String?              @map("seller_user_id") @db.Uuid
  /// % de comisión vigente al facturar (la comisión se devenga al cobrar).
  commissionPct     Decimal?             @map("commission_pct") @db.Decimal(5, 2)
  /// Nota de crédito con devolución: depósito donde reingresa la mercadería.
  returnWarehouseId String?              @map("return_warehouse_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String               @map("created_by") @db.Uuid
  lines             FiscalDocumentLine[]

  @@unique([companyId, direction, partyId, docType, pointOfSale, number])
  @@index([companyId, partyId])
  @@map("fiscal_documents")
}

model FiscalDocumentLine {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  documentId     String         @map("document_id") @db.Uuid
  itemId         String?        @map("item_id") @db.Uuid
  description    String
  qty            Decimal        @db.Decimal(18, 4)
  unitPrice      Decimal        @map("unit_price") @db.Decimal(18, 6)
  vatRate        Decimal        @map("vat_rate") @db.Decimal(5, 2)
  net            Decimal        @db.Decimal(18, 2)
  vat            Decimal        @db.Decimal(18, 2)
  receiptLineId  String?        @map("receipt_line_id") @db.Uuid
  discountPct    Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  /// Venta: línea de remito facturada.
  deliveryLineId String?        @map("delivery_line_id") @db.Uuid
  /// Nota de crédito: línea de la factura que se acredita.
  relatedLineId  String?        @map("related_line_id") @db.Uuid
  document       FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("fiscal_document_lines")
}

enum AccountType {
  RECEIVABLE
  PAYABLE
}

/// Cuenta corriente. `amount` inmutable; `open_amount` cambia solo por imputaciones (Fase 3/4).
/// Signo: positivo = aumenta lo que el tercero nos debe (RECEIVABLE) o lo que le debemos (PAYABLE).
model AccountEntry {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  partyId       String      @map("party_id") @db.Uuid
  accountType   AccountType @map("account_type")
  entryType     String      @map("entry_type")
  sourceDocType String      @map("source_doc_type")
  sourceDocId   String      @map("source_doc_id") @db.Uuid
  description   String
  date          DateTime    @db.Date
  dueDate       DateTime?   @map("due_date") @db.Date
  amount        Decimal     @db.Decimal(18, 2)
  openAmount    Decimal     @map("open_amount") @db.Decimal(18, 2)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String      @map("created_by") @db.Uuid

  @@index([companyId, partyId, accountType, date])
  @@map("account_entries")
}

// ───────────────────────────── Producción ─────────────────────────────

model ProductionStage {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  code       String
  name       String
  sortOrder  Int     @map("sort_order")
  /// La etapa la puede hacer un taller externo.
  isExternal Boolean @default(false) @map("is_external")
  isActive   Boolean @default(true) @map("is_active")

  @@unique([companyId, code])
  @@map("production_stages")
}

model DefectReason {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  isActive  Boolean @default(true) @map("is_active")

  @@unique([companyId, name])
  @@map("defect_reasons")
}

model TechSheet {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  productId        String             @unique @map("product_id") @db.Uuid
  currentVersionId String?            @map("current_version_id") @db.Uuid
  versions         TechSheetVersion[]

  @@map("tech_sheets")
}

enum TechSheetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Una versión ACTIVE o ARCHIVED no se modifica: cambiarla crea una versión nueva.
model TechSheetVersion {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  techSheetId  String              @map("tech_sheet_id") @db.Uuid
  versionNo    Int                 @map("version_no")
  status       TechSheetStatus     @default(DRAFT)
  /// Etapas que recorre la prenda (ids de production_stages, en orden).
  stageIds     String[]            @map("stage_ids") @db.Uuid
  instructions String?
  activatedAt  DateTime?           @map("activated_at") @db.Timestamptz
  activatedBy  String?             @map("activated_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String              @map("created_by") @db.Uuid
  techSheet    TechSheet           @relation(fields: [techSheetId], references: [id])
  materials    TechSheetMaterial[]

  @@unique([techSheetId, versionNo])
  @@map("tech_sheet_versions")
}

/// Consumo de un material por prenda. Si `byGarmentColor`, el material depende del color de la prenda
/// (colorMap: color de prenda → material). `sizeQty` pisa el consumo por talle.
model TechSheetMaterial {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  versionId      String           @map("version_id") @db.Uuid
  materialItemId String?          @map("material_item_id") @db.Uuid
  byGarmentColor Boolean          @default(false) @map("by_garment_color")
  /// { [garmentColorId]: materialItemId }
  colorMap       Json             @default("{}") @map("color_map")
  qtyPerUnit     Decimal          @map("qty_per_unit") @db.Decimal(18, 4)
  /// { [sizeId]: qty }
  sizeQty        Json             @default("{}") @map("size_qty")
  wastePct       Decimal          @default(0) @map("waste_pct") @db.Decimal(5, 2)
  notes          String?
  sortOrder      Int              @default(0) @map("sort_order")
  version        TechSheetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("tech_sheet_materials")
}

/// Tarifa del taller por prenda terminada de un modelo. Histórica: vale la vigente a la fecha.
model WorkshopRate {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  workshopId String   @map("workshop_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  price      Decimal  @db.Decimal(18, 2)
  validFrom  DateTime @map("valid_from") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String   @map("created_by") @db.Uuid

  @@unique([workshopId, productId, validFrom])
  @@index([companyId, productId])
  @@map("workshop_rates")
}

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

model ProductionOrder {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @map("company_id") @db.Uuid
  number               String
  status               ProductionOrderStatus   @default(DRAFT)
  productId            String                  @map("product_id") @db.Uuid
  techSheetVersionId   String?                 @map("tech_sheet_version_id") @db.Uuid
  priority             Int                     @default(2)
  plannedStart         DateTime?               @map("planned_start") @db.Date
  dueDate              DateTime?               @map("due_date") @db.Date
  responsibleUserId    String?                 @map("responsible_user_id") @db.Uuid
  materialsWarehouseId String                  @map("materials_warehouse_id") @db.Uuid
  outputWarehouseId    String                  @map("output_warehouse_id") @db.Uuid
  secondsWarehouseId   String?                 @map("seconds_warehouse_id") @db.Uuid
  notes                String?
  estimatedUnitCost    Decimal?                @map("estimated_unit_cost") @db.Decimal(18, 6)
  releasedAt           DateTime?               @map("released_at") @db.Timestamptz
  closedAt             DateTime?               @map("closed_at") @db.Timestamptz
  cancelReason         String?                 @map("cancel_reason")
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String                  @map("created_by") @db.Uuid
  lines                ProductionOrderLine[]
  requirements         ProductionRequirement[]
  stages               ProductionOrderStage[]

