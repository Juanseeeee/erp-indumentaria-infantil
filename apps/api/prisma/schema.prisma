  companyId      String   @map("company_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  qtyGood        Decimal  @map("qty_good") @db.Decimal(18, 4)
  qtyDefect      Decimal  @default(0) @map("qty_defect") @db.Decimal(18, 4)
  defectReasonId String?  @map("defect_reason_id") @db.Uuid
  notes          String?
  reportedAt     DateTime @default(now()) @map("reported_at") @db.Timestamptz
  reportedBy     String   @map("reported_by") @db.Uuid

