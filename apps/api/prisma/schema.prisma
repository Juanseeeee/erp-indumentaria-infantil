  @@index([companyId, status])
  @@map("production_orders")
}

model ProductionOrderLine {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  variantItemId String          @map("variant_item_id") @db.Uuid
  plannedQty    Decimal         @map("planned_qty") @db.Decimal(18, 4)
  goodQty       Decimal         @default(0) @map("good_qty") @db.Decimal(18, 4)
  secondQty     Decimal         @default(0) @map("second_qty") @db.Decimal(18, 4)
  scrapQty      Decimal         @default(0) @map("scrap_qty") @db.Decimal(18, 4)
  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, variantItemId])
  @@map("production_order_lines")
}

/// Explosión de la ficha para la OP. issued = entregado (consumo interno o envío a taller);
/// atWorkshop = en poder del taller; consumed = consumido; returned = devuelto.
model ProductionRequirement {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  materialItemId String          @map("material_item_id") @db.Uuid
  requiredQty    Decimal         @map("required_qty") @db.Decimal(18, 4)
  issuedQty      Decimal         @default(0) @map("issued_qty") @db.Decimal(18, 4)
  atWorkshopQty  Decimal         @default(0) @map("at_workshop_qty") @db.Decimal(18, 4)
  consumedQty    Decimal         @default(0) @map("consumed_qty") @db.Decimal(18, 4)
  returnedQty    Decimal         @default(0) @map("returned_qty") @db.Decimal(18, 4)
  reservationId  String?         @map("reservation_id") @db.Uuid
  order          ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, materialItemId])
  @@map("production_requirements")
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

model ProductionOrderStage {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  orderId      String          @map("order_id") @db.Uuid
  stageId      String          @map("stage_id") @db.Uuid
  sortOrder    Int             @map("sort_order")
  status       StageStatus     @default(PENDING)
  completedQty Decimal         @default(0) @map("completed_qty") @db.Decimal(18, 4)
  defectQty    Decimal         @default(0) @map("defect_qty") @db.Decimal(18, 4)
  workshopId   String?         @map("workshop_id") @db.Uuid
  startedAt    DateTime?       @map("started_at") @db.Timestamptz
  finishedAt   DateTime?       @map("finished_at") @db.Timestamptz
  order        ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

