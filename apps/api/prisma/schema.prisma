// Modelo de datos — Fase 1 (plataforma, terceros, catálogo, materiales, inventario).
// Convención: modelos en PascalCase, tablas y columnas en snake_case.
// Las restricciones que Prisma no expresa (RLS, CHECKs, índices NULLS NOT DISTINCT,
// triggers append-only) están en migrations/*_constraints/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Migraciones con el rol propietario; la app usa erp_app (sujeto a RLS).
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ───────────────────────────── Plataforma ─────────────────────────────

model Company {
  id           String    @id @default(uuid()) @db.Uuid
  legalName    String    @map("legal_name")
  tradeName    String?   @map("trade_name")
  cuit         String    @unique
  taxCondition String    @map("tax_condition")
  address      String?
  settings     Json      @default("{}")
  /// Último día cerrado: no se registran operaciones con fecha igual o anterior (trigger en la base).
  lockedUntil  DateTime? @map("locked_until") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("companies")
}

model Branch {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  name            String
  address         String?
  arcaPointOfSale Int?    @map("arca_point_of_sale")
  isActive        Boolean @default(true) @map("is_active")

  @@unique([companyId, name])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  memberships CompanyUser[]
  sessions    Session[]

  @@map("users")
}

model CompanyUser {
  companyId       String  @map("company_id") @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  defaultBranchId String? @map("default_branch_id") @db.Uuid
  isActive        Boolean @default(true) @map("is_active")

  user  User       @relation(fields: [userId], references: [id])
  roles UserRole[]

  @@id([companyId, userId])
  @@map("company_users")
}

model Permission {
  code        String @id
  module      String
  description String

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  code        String
  name        String
  isSystem    Boolean          @default(false) @map("is_system")
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")
  companyId      String @map("company_id") @db.Uuid
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  companyId  String      @map("company_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  roleId     String      @map("role_id") @db.Uuid
  membership CompanyUser @relation(fields: [companyId, userId], references: [companyId, userId])
  role       Role        @relation(fields: [roleId], references: [id])

  @@id([companyId, userId, roleId])
  @@map("user_roles")
}

/// Alcance de datos por usuario (p.ej. un depósito o un vendedor).
model UserScope {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  scopeType String @map("scope_type")
  scopeId   String @map("scope_id") @db.Uuid

  @@unique([companyId, userId, scopeType, scopeId])
  @@map("user_scopes")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  csrfToken  String    @map("csrf_token")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Append-only.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  companyId String   @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz
  ip        String?
  entity    String
  entityId  String   @map("entity_id")
  action    String
  diff      Json?
  reason    String?

  @@index([companyId, entity, entityId])
  @@index([companyId, userId, at])
  @@map("audit_log")
}

model IdempotencyKey {
  companyId   String   @map("company_id") @db.Uuid
  key         String
  userId      String   @map("user_id") @db.Uuid
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([companyId, key])
  @@map("idempotency_keys")
}

model DocumentSequence {
  companyId  String  @map("company_id") @db.Uuid
  docType    String  @map("doc_type")
  /// '' cuando la numeración no depende de sucursal/punto de venta.
  seriesKey  String  @default("") @map("series_key")
  prefix     String  @default("")
  nextNumber Int     @default(1) @map("next_number")
  padding    Int     @default(8)
  gapless    Boolean @default(false)

  @@id([companyId, docType, seriesKey])
  @@map("document_sequences")
}

model ApprovalRule {
  id                 String  @id @default(uuid()) @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  actionCode         String  @map("action_code")
  /// Umbral (importe o cantidad valorizada) a partir del cual se requiere aprobación.
  threshold          Decimal @db.Decimal(18, 2)
  requiredPermission String  @map("required_permission")
  isActive           Boolean @default(true) @map("is_active")

  @@unique([companyId, actionCode])
  @@map("approval_rules")
}

model Setting {
  companyId String @map("company_id") @db.Uuid
  key       String
  value     Json

  @@id([companyId, key])
  @@map("settings")
}

// ───────────────────────────── Terceros ─────────────────────────────

enum TaxIdType {
  CUIT
  CUIL
  DNI
  OTHER
}

enum TaxCondition {
  RI
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_ALCANZADO
}

enum PartyRoleType {
  CUSTOMER
  SUPPLIER
  WORKSHOP
}

model Party {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  code         String
  legalName    String       @map("legal_name")
  tradeName    String?      @map("trade_name")
  taxIdType    TaxIdType    @map("tax_id_type")
  taxId        String       @map("tax_id")
  taxCondition TaxCondition @map("tax_condition")
  email        String?
  phone        String?
  notes        String?
  isActive     Boolean      @default(true) @map("is_active")
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.Uuid
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  roles           PartyRole[]
  addresses       PartyAddress[]
  contacts        PartyContact[]
  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?

  @@unique([companyId, code])
  @@unique([companyId, taxIdType, taxId])
  @@map("parties")
}

model PartyRole {
  partyId   String        @map("party_id") @db.Uuid
  role      PartyRoleType
  companyId String        @map("company_id") @db.Uuid
  party     Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@id([partyId, role])
  @@index([companyId, role])
  @@map("party_roles")
}

model PartyAddress {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  partyId   String  @map("party_id") @db.Uuid
  type      String  @default("FISCAL")
  street    String
  city      String?
  province  String?
  zip       String?
  isDefault Boolean @default(false) @map("is_default")
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_addresses")
}

model PartyContact {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  partyId   String  @map("party_id") @db.Uuid
  name      String
  role      String?
  phone     String?
  email     String?
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_contacts")
}

model PaymentTerm {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  /// Días de cada cuota, p.ej. [30, 60, 90].
  days      Int[]
  isActive  Boolean @default(true) @map("is_active")

  @@unique([companyId, name])
  @@map("payment_terms")
}

model Zone {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String

  @@unique([companyId, name])
  @@map("zones")
}

model CustomerProfile {
  partyId       String   @id @map("party_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  zoneId        String?  @map("zone_id") @db.Uuid
  sellerUserId  String?  @map("seller_user_id") @db.Uuid
  paymentTermId String?  @map("payment_term_id") @db.Uuid
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(18, 2)
  discountPct   Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  priceListId   String?  @map("price_list_id") @db.Uuid
  party         Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model SupplierProfile {
  partyId       String  @id @map("party_id") @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  paymentTermId String? @map("payment_term_id") @db.Uuid
  currency      String  @default("ARS")
  party         Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("supplier_profiles")
}

// ───────────────────────────── Catálogo y materiales ─────────────────────────────

enum UomDimension {
  UNIT
  LENGTH
  MASS
  AREA
}

model Uom {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String
  name      String
  dimension UomDimension
  isActive  Boolean      @default(true) @map("is_active")

  @@unique([companyId, code])
  @@map("uoms")
}

model UomConversion {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  fromUomId String  @map("from_uom_id") @db.Uuid
  toUomId   String  @map("to_uom_id") @db.Uuid
  factor    Decimal @db.Decimal(18, 6)
  /// null = universal.
  itemId    String? @map("item_id") @db.Uuid

  @@map("uom_conversions")
}

enum CategoryKind {
  PRODUCT
  MATERIAL
  EXPENSE
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  parentId         String?           @map("parent_id") @db.Uuid
  kind             CategoryKind
  name             String
  isActive         Boolean           @default(true) @map("is_active")
  expenses         Expense[]
  expenseTemplates ExpenseTemplate[]

  @@unique([companyId, kind, name])
  @@map("categories")
}

model Season {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String
  year        Int
  collections Collection[]

  @@unique([companyId, name])
  @@map("seasons")
}

model Collection {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  seasonId  String @map("season_id") @db.Uuid
  name      String
  season    Season @relation(fields: [seasonId], references: [id])

  @@unique([companyId, name])
  @@map("collections")
}

model SizeScale {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String
  sizes     Size[]

  @@unique([companyId, name])
  @@map("size_scales")
}

model Size {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  sizeScaleId String    @map("size_scale_id") @db.Uuid
  code        String
  sortOrder   Int       @map("sort_order")
  scale       SizeScale @relation(fields: [sizeScaleId], references: [id], onDelete: Cascade)

  @@unique([sizeScaleId, code])
  @@map("sizes")
}

model Color {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  hex       String?
  isActive  Boolean @default(true) @map("is_active")

  @@unique([companyId, code])
  @@map("colors")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

/// El "modelo" (p.ej. Body manga larga). Las variantes talle×color son Items.
model Product {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  code         String
  name         String
  description  String?
  categoryId   String?       @map("category_id") @db.Uuid
  collectionId String?       @map("collection_id") @db.Uuid
  sizeScaleId  String        @map("size_scale_id") @db.Uuid
  status       ProductStatus @default(DRAFT)
  materialText String?       @map("material_text")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  variants ProductVariant[]

  @@unique([companyId, code])
  @@map("products")
}

enum ItemKind {
  VARIANT
  MATERIAL
}

/// Todo lo que tiene stock.
model Item {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  kind          ItemKind
  sku           String
  barcode       String?
  name          String
  baseUomId     String   @map("base_uom_id") @db.Uuid
  trackLots     Boolean  @default(false) @map("track_lots")
  allowNegative Boolean  @default(false) @map("allow_negative")
  minStock      Decimal? @map("min_stock") @db.Decimal(18, 4)
  reorderQty    Decimal? @map("reorder_qty") @db.Decimal(18, 4)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  variant  ProductVariant?
  material Material?

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, kind])
  @@map("items")
}

model ProductVariant {
  itemId    String  @id @map("item_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  sizeId    String  @map("size_id") @db.Uuid
  colorId   String  @map("color_id") @db.Uuid
  item      Item    @relation(fields: [itemId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, sizeId, colorId])
  @@map("product_variants")
}

model Material {
  itemId            String   @id @map("item_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  categoryId        String?  @map("category_id") @db.Uuid
  defaultSupplierId String?  @map("default_supplier_id") @db.Uuid
  purchaseUomId     String?  @map("purchase_uom_id") @db.Uuid
  fabricWidthCm     Decimal? @map("fabric_width_cm") @db.Decimal(8, 2)
  composition       String?
  weightGsm         Decimal? @map("weight_gsm") @db.Decimal(8, 2)
  colorId           String?  @map("color_id") @db.Uuid
  lastCost          Decimal? @map("last_cost") @db.Decimal(18, 6)
  item              Item     @relation(fields: [itemId], references: [id])

  @@map("materials")
}

// ───────────────────────────── Inventario ─────────────────────────────

enum WarehouseType {
  OWN
  WORKSHOP
  TRANSIT
  QUARANTINE
}

model Warehouse {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  branchId  String?       @map("branch_id") @db.Uuid
  code      String
  name      String
  type      WarehouseType @default(OWN)
  partyId   String?       @unique @map("party_id") @db.Uuid
  isActive  Boolean       @default(true) @map("is_active")
  locations Location[]

  @@unique([companyId, code])
  @@map("warehouses")
}

model Location {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String
  name        String?
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
  @@map("locations")
}

model Lot {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  code        String
  supplierLot String?  @map("supplier_lot")
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([companyId, itemId, code])
  @@map("lots")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALE_DELIVERY
  SALE_RETURN
  PROD_ISSUE
  PROD_RETURN
  PROD_OUTPUT
  PROD_SCRAP
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT_ADJUSTMENT
}

/// Append-only. Fuente de verdad del inventario.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  itemId          String            @map("item_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  locationId      String?           @map("location_id") @db.Uuid
  lotId           String?           @map("lot_id") @db.Uuid
  type            StockMovementType
  qty             Decimal           @db.Decimal(18, 4)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(18, 6)
  totalCost       Decimal           @map("total_cost") @db.Decimal(18, 2)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(18, 4)
  sourceDocType   String            @map("source_doc_type")
  sourceDocId     String            @map("source_doc_id") @db.Uuid
  sourceLineId    String?           @map("source_line_id") @db.Uuid
  transferGroupId String?           @map("transfer_group_id") @db.Uuid
  reason          String?
  occurredAt      DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  createdBy       String            @map("created_by") @db.Uuid

  @@index([companyId, itemId, warehouseId, occurredAt])
  @@index([companyId, sourceDocType, sourceDocId])
  @@map("stock_movements")
}

/// Proyección de saldos: se actualiza en la misma transacción que el movimiento.
/// Unicidad (company, item, warehouse, location, lot) con NULLS NOT DISTINCT vía SQL.
model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 4)
  reserved    Decimal  @default(0) @db.Decimal(18, 4)
  avgCost     Decimal  @default(0) @map("avg_cost") @db.Decimal(18, 6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([companyId, itemId])
  @@index([companyId, warehouseId])
  @@map("stock_balances")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model StockReservation {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  itemId        String            @map("item_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  qty           Decimal           @db.Decimal(18, 4)
  consumedQty   Decimal           @default(0) @map("consumed_qty") @db.Decimal(18, 4)
  status        ReservationStatus @default(ACTIVE)
  sourceDocType String            @map("source_doc_type")
  sourceDocId   String            @map("source_doc_id") @db.Uuid
  sourceLineId  String?           @map("source_line_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String            @map("created_by") @db.Uuid

  @@index([companyId, itemId, warehouseId, status])
  @@index([companyId, sourceDocType, sourceDocId])
  @@map("stock_reservations")
}

enum StockDocType {
  OPENING
  ADJUSTMENT
  TRANSFER
}

enum StockDocStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  VOIDED
}

/// Documento interno de inventario: carga inicial, ajuste o transferencia.
model StockDocument {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  type              StockDocType
  number            String
  status            StockDocStatus      @default(DRAFT)
  warehouseId       String              @map("warehouse_id") @db.Uuid
  targetWarehouseId String?             @map("target_warehouse_id") @db.Uuid
  reason            String?
  notes             String?
  totalValue        Decimal             @default(0) @map("total_value") @db.Decimal(18, 2)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String              @map("created_by") @db.Uuid
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz
  postedBy          String?             @map("posted_by") @db.Uuid
  approvedBy        String?             @map("approved_by") @db.Uuid
  version           Int                 @default(1)
  lines             StockDocumentLine[]

  @@unique([companyId, type, number])
  @@index([companyId, status])
  @@map("stock_documents")
}

model StockDocumentLine {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  documentId String        @map("document_id") @db.Uuid
  itemId     String        @map("item_id") @db.Uuid
  lotId      String?       @map("lot_id") @db.Uuid
  /// Con signo para ajustes; positiva para cargas iniciales y transferencias.
