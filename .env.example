# Runtime: rol de aplicación sujeto a RLS
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5433/erp?schema=public
# Migraciones / seed: rol propietario
DATABASE_MIGRATION_URL=postgresql://erp:erp@localhost:5433/erp?schema=public
DATABASE_URL_TEST=postgresql://erp_app:erp_app@localhost:5433/erp_test?schema=public
DATABASE_MIGRATION_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Correo saliente (alertas). En desarrollo, Mailpit: http://localhost:8025. Vacío = no se envía.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Ositos ERP <alertas@ositos.local>"
# Evaluación automática de alertas (minutos; 0 = desactivada)
ALERTS_INTERVAL_MINUTES=15
# Asistente. Motor según ASSISTANT_PROVIDER: auto (Claude si hay clave de Anthropic, si no Gemini si hay
# clave de Google, si no modo guía) | claude | gemini | guide. El modo guía no usa IA ni envía datos afuera.
ASSISTANT_PROVIDER=auto
# Gemini (plan gratuito en https://aistudio.google.com/apikey; en ese plan Google puede usar los datos enviados).
GEMINI_API_KEY=
# Claude (Anthropic, pago).
ANTHROPIC_API_KEY=
# Opcionales: modelo (por defecto gemini-3.8-flash o claude-opus-5-5), esfuerzo de Claude y mensajes
# a la IA por usuario cada 10 minutos (después responde con la guía).
ASSISTANT_MODEL=
ASSISTANT_EFFORT=low
ASSISTANT_RATE_LIMIT=30
