# Runtime: rol de aplicación sujeto a RLS
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5433/erp?schema=public
# Migraciones / seed: rol propietario
DATABASE_MIGRATION_URL=postgresql://erp:erp@localhost:5433/erp?schema=public
DATABASE_URL_TEST=postgresql://erp_app:erp_app@localhost:5433/erp_test?schema=public
DATABASE_MIGRATION_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Correo saliente (alertas). En desarrollo, Mailpit: http://localhost:8025. Vacío = no se envía.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Ositos ERP <alertas@ositos.local>"
# Evaluación automática de alertas (minutos; 0 = desactivada)
ALERTS_INTERVAL_MINUTES=15
